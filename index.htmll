<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#07111f">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Solar Weather">
<title>Solar Weather</title>

<style>
* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

body {
  margin: 0;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display",
    "Helvetica Neue", Arial, sans-serif;
  background: #07111f;
  color: white;
  min-height: 100vh;
}

.app {
  width: 100%;
  max-width: 430px;
  min-height: 100vh;
  margin: auto;
  padding: env(safe-area-inset-top) 18px env(safe-area-inset-bottom);
  background:
    radial-gradient(circle at 50% -10%, #294d72 0%, transparent 42%),
    linear-gradient(180deg, #0b1b2e 0%, #07111f 70%);
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22px 2px 12px;
}

.title {
  font-size: 29px;
  font-weight: 700;
}

.subtitle {
  color: #a9bbce;
  font-size: 14px;
  margin-top: 3px;
}

.icon-button {
  width: 44px;
  height: 44px;
  border: 0;
  border-radius: 50%;
  background: rgba(255,255,255,.1);
  color: white;
  font-size: 21px;
  cursor: pointer;
}

.search {
  display: flex;
  gap: 8px;
  margin: 8px 0 18px;
}

.search input {
  flex: 1;
  min-width: 0;
  border: 0;
  outline: none;
  border-radius: 15px;
  padding: 14px 16px;
  background: rgba(255,255,255,.1);
  color: white;
  font-size: 16px;
}

.search input::placeholder {
  color: #91a5b8;
}

.search button {
  border: 0;
  border-radius: 15px;
  padding: 0 16px;
  background: #fff;
  color: #07111f;
  font-weight: 700;
  cursor: pointer;
}

.card {
  border-radius: 25px;
  background: rgba(255,255,255,.095);
  border: 1px solid rgba(255,255,255,.09);
  box-shadow: 0 15px 40px rgba(0,0,0,.18);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.current {
  padding: 24px;
  text-align: center;
  margin-bottom: 15px;
}

.location {
  font-size: 18px;
  font-weight: 600;
}

.date {
  color: #a9bbce;
  font-size: 14px;
  margin-top: 5px;
}

.sun {
  width: 105px;
  height: 105px;
  margin: 20px auto 12px;
  border-radius: 50%;
  background: #ffd86b;
  box-shadow:
    0 0 25px #ffd86b,
    0 0 65px rgba(255,216,107,.45);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52px;
}

.temperature {
  font-size: 66px;
  line-height: 1;
  font-weight: 300;
  letter-spacing: -3px;
}

.condition {
  font-size: 20px;
  margin-top: 7px;
  font-weight: 600;
}

.details {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  margin-top: 22px;
}

.detail {
  padding: 12px 5px;
  background: rgba(255,255,255,.07);
  border-radius: 15px;
}

.detail-icon {
  font-size: 20px;
}

.detail-label {
  font-size: 11px;
  color: #9fb1c4;
  margin-top: 4px;
}

.detail-value {
  font-size: 14px;
  font-weight: 600;
  margin-top: 2px;
}

.section-title {
  font-size: 19px;
  font-weight: 700;
  margin: 22px 3px 10px;
}

.hourly {
  display: flex;
  gap: 10px;
  overflow-x: auto;
  padding-bottom: 4px;
  scrollbar-width: none;
}

.hourly::-webkit-scrollbar {
  display: none;
}

.hour {
  min-width: 78px;
  padding: 14px 8px;
  text-align: center;
}

.hour-time {
  color: #a9bbce;
  font-size: 12px;
}

.hour-icon {
  font-size: 25px;
  margin: 10px 0;
}

.hour-temp {
  font-size: 17px;
  font-weight: 600;
}

.forecast {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.day {
  display: grid;
  grid-template-columns: 1fr 45px 75px;
  align-items: center;
  padding: 15px 17px;
}

.day-name {
  font-weight: 600;
}

.day-icon {
  font-size: 25px;
  text-align: center;
}

.day-temp {
  text-align: right;
  color: #cbd7e3;
}

.solar {
  margin-top: 18px;
  padding: 20px;
}

.solar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.solar-title {
  font-size: 18px;
  font-weight: 700;
}

.badge {
  background: rgba(255,196,70,.18);
  color: #ffd86b;
  padding: 5px 9px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 700;
}

.bar {
  height: 9px;
  background: rgba(255,255,255,.1);
  border-radius: 20px;
  margin: 17px 0 8px;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  width: 63%;
  border-radius: 20px;
  background: linear-gradient(90deg,#ffd86b,#ff9d3d);
}

.solar-info {
  display: flex;
  justify-content: space-between;
  color: #a9bbce;
  font-size: 12px;
}

.bottom-space {
  height: 30px;
}

.toast {
  position: fixed;
  left: 50%;
  bottom: 25px;
  transform: translate(-50%, 120px);
  background: white;
  color: #07111f;
  padding: 13px 18px;
  border-radius: 15px;
  font-weight: 600;
  font-size: 14px;
  transition: .3s ease;
  z-index: 20;
  box-shadow: 0 8px 30px rgba(0,0,0,.3);
}

.toast.show {
  transform: translate(-50%, 0);
}

.loading {
  opacity: .5;
}

@media (min-width: 500px) {
  body {
    padding: 20px 0;
  }

  .app {
    border-radius: 35px;
    min-height: calc(100vh - 40px);
    box-shadow: 0 20px 60px rgba(0,0,0,.35);
  }
}
</style>
</head>

<body>

<div class="app">

  <header class="header">
    <div>
      <div class="title">Solar Weather</div>
      <div class="subtitle">Weather • Solar conditions</div>
    </div>

    <button class="icon-button" onclick="getLocation()" aria-label="Use location">
      ⌖
    </button>
  </header>

  <div class="search">
    <input id="cityInput" type="text" placeholder="Search city">
    <button onclick="searchCity()">Search</button>
  </div>

  <section class="card current">

    <div class="location" id="location">New York, NY</div>
    <div class="date" id="date">Today</div>

    <div class="sun">☀️</div>

    <div class="temperature" id="temperature">72°</div>
    <div class="condition" id="condition">Sunny</div>

    <div class="details">

      <div class="detail">
        <div class="detail-icon">💧</div>
        <div class="detail-label">Humidity</div>
        <div class="detail-value" id="humidity">48%</div>
      </div>

      <div class="detail">
        <div class="detail-icon">💨</div>
        <div class="detail-label">Wind</div>
        <div class="detail-value" id="wind">8 mph</div>
      </div>

      <div class="detail">
        <div class="detail-icon">☀️</div>
        <div class="detail-label">UV Index</div>
        <div class="detail-value" id="uv">6 High</div>
      </div>

    </div>
  </section>

  <div class="section-title">Hourly Forecast</div>

  <div class="hourly">

    <div class="card hour">
      <div class="hour-time">Now</div>
      <div class="hour-icon">☀️</div>
      <div class="hour-temp">72°</div>
    </div>

    <div class="card hour">
      <div class="hour-time">6 PM</div>
      <div class="hour-icon">🌤️</div>
      <div class="hour-temp">70°</div>
    </div>

    <div class="card hour">
      <div class="hour-time">7 PM</div>
      <div class="hour-icon">🌤️</div>
      <div class="hour-temp">68°</div>
    </div>

    <div class="card hour">
      <div class="hour-time">8 PM</div>
      <div class="hour-icon">🌙</div>
      <div class="hour-temp">66°</div>
    </div>

    <div class="card hour">
      <div class="hour-time">9 PM</div>
      <div class="hour-icon">🌙</div>
      <div class="hour-temp">64°</div>
    </div>

  </div>

  <div class="section-title">7-Day Forecast</div>

  <div class="forecast">

    <div class="card day">
      <div class="day-name">Today</div>
      <div class="day-icon">☀️</div>
      <div class="day-temp">72° / 61°</div>
    </div>

    <div class="card day">
      <div class="day-name">Tue</div>
      <div class="day-icon">🌤️</div>
      <div class="day-temp">74° / 62°</div>
    </div>

    <div class="card day">
      <div class="day-name">Wed</div>
      <div class="day-icon">⛅</div>
      <div class="day-temp">76° / 64°</div>
    </div>

    <div class="card day">
      <div class="day-name">Thu</div>
      <div class="day-icon">🌧️</div>
      <div class="day-temp">69° / 59°</div>
    </div>

    <div class="card day">
      <div class="day-name">Fri</div>
      <div class="day-icon">☀️</div>
      <div class="day-temp">73° / 60°</div>
    </div>

  </div>

  <section class="card solar">

    <div class="solar-header">
      <div class="solar-title">☀️ Solar Activity</div>
      <div class="badge">MODERATE</div>
    </div>

    <div class="bar">
      <div class="bar-fill"></div>
    </div>

    <div class="solar-info">
      <span>Low</span>
      <span>Current activity</span>
      <span>High</span>
    </div>

  </section>

  <div class="bottom-space"></div>

</div>

<div class="toast" id="toast"></div>

<script>

function showToast(message) {
  const toast = document.getElementById("toast");
  toast.textContent = message;
  toast.classList.add("show");

  setTimeout(() => {
    toast.classList.remove("show");
  }, 2500);
}

function updateDate() {
  const now = new Date();

  document.getElementById("date").textContent =
    now.toLocaleDateString(undefined, {
      weekday: "long",
      month: "long",
      day: "numeric"
    });
}

function searchCity() {

  const input = document.getElementById("cityInput");
  const city = input.value.trim();

  if (!city) {
    showToast("Enter a city first");
    return;
  }

  document.getElementById("location").textContent = city;

  showToast("Weather updated for " + city);

  input.value = "";
}

function getLocation() {

  if (!navigator.geolocation) {
    showToast("Location is not supported");
    return;
  }

  showToast("Finding your location...");

  navigator.geolocation.getCurrentPosition(

    position => {

      const lat = position.coords.latitude;
      const lon = position.coords.longitude;

      document.getElementById("location").textContent =
        "Your Location";

      showToast(
        "Location found • " +
        lat.toFixed(2) +
        ", " +
        lon.toFixed(2)
      );

    },

    () => {
      showToast("Location permission was not granted");
    }
  );
}

updateDate();

</script>

</body>
</html>by
