<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#07111f">
<title>Solar Weather</title>

<style>
* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

body {
  margin: 0;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display",
               "Helvetica Neue", Arial, sans-serif;
  background: #07111f;
  color: white;
  min-height: 100vh;
}

.app {
  max-width: 430px;
  min-height: 100vh;
  margin: auto;
  padding: 20px 18px 35px;
  background:
    radial-gradient(circle at 80% 5%, rgba(0,153,255,.28), transparent 30%),
    radial-gradient(circle at 10% 35%, rgba(255,177,0,.18), transparent 28%),
    linear-gradient(180deg, #07111f, #0b1728 60%, #050b14);
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22px;
}

.title {
  font-size: 30px;
  font-weight: 800;
  letter-spacing: -1px;
}

.subtitle {
  color: #8ea1b8;
  font-size: 14px;
  margin-top: 3px;
}

.refresh {
  width: 46px;
  height: 46px;
  border: 0;
  border-radius: 50%;
  background: rgba(255,255,255,.1);
  color: white;
  font-size: 22px;
}

.location {
  display: flex;
  align-items: center;
  gap: 7px;
  color: #a9bbd0;
  margin-bottom: 14px;
  font-size: 14px;
}

.hero {
  border-radius: 28px;
  padding: 25px;
  min-height: 250px;
  background:
    radial-gradient(circle at 70% 30%, rgba(255,195,50,.45), transparent 25%),
    linear-gradient(145deg, #122b49, #0b182a);
  box-shadow: 0 15px 40px rgba(0,0,0,.35);
  position: relative;
  overflow: hidden;
}

.sun {
  position: absolute;
  right: 25px;
  top: 30px;
  width: 105px;
  height: 105px;
  border-radius: 50%;
  background: #ffc83d;
  box-shadow:
    0 0 30px #ffc83d,
    0 0 65px rgba(255,190,40,.65);
}

.hero-label {
  color: #9db2ca;
  font-size: 15px;
}

.temperature {
  font-size: 68px;
  font-weight: 700;
  letter-spacing: -4px;
  margin-top: 25px;
}

.condition {
  font-size: 21px;
  font-weight: 600;
}

.highlow {
  color: #9db2ca;
  margin-top: 8px;
}

.section-title {
  font-size: 20px;
  font-weight: 700;
  margin: 28px 3px 13px;
}

.cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.card {
  padding: 18px;
  border-radius: 21px;
  background: rgba(255,255,255,.075);
  border: 1px solid rgba(255,255,255,.08);
  min-height: 135px;
}

.card-icon {
  font-size: 25px;
  margin-bottom: 12px;
}

.card-name {
  color: #8fa3ba;
  font-size: 13px;
}

.card-value {
  font-size: 25px;
  font-weight: 700;
  margin-top: 5px;
}

.card-status {
  color: #65e6a0;
  font-size: 12px;
  margin-top: 5px;
}

.activity {
  padding: 20px;
  border-radius: 23px;
  background: rgba(255,255,255,.075);
  border: 1px solid rgba(255,255,255,.08);
}

.activity-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.activity-name {
  font-size: 17px;
  font-weight: 700;
}

.badge {
  padding: 6px 10px;
  border-radius: 20px;
  background: rgba(74,222,128,.15);
  color: #70e7a0;
  font-size: 12px;
  font-weight: 700;
}

.bar {
  height: 9px;
  margin-top: 17px;
  border-radius: 10px;
  background: #17263a;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  width: 62%;
  border-radius: 10px;
  background: linear-gradient(90deg, #32a5ff, #ffd34d);
}

.scale {
  display: flex;
  justify-content: space-between;
  color: #71849b;
  font-size: 11px;
  margin-top: 8px;
}

.forecast {
  display: flex;
  gap: 9px;
  overflow-x: auto;
  padding-bottom: 5px;
}

.forecast::-webkit-scrollbar {
  display: none;
}

.day {
  min-width: 82px;
  text-align: center;
  padding: 15px 8px;
  border-radius: 18px;
  background: rgba(255,255,255,.07);
}

.day-name {
  color: #8fa3ba;
  font-size: 12px;
}

.day-icon {
  font-size: 27px;
  margin: 10px 0;
}

.day-temp {
  font-weight: 700;
}

.info {
  margin-top: 25px;
  padding: 18px;
  border-radius: 20px;
  background: rgba(30,145,255,.1);
  border: 1px solid rgba(30,145,255,.15);
  color: #a9c5df;
  font-size: 13px;
  line-height: 1.5;
}

button {
  cursor: pointer;
}

.refresh:active {
  transform: scale(.9);
}

.footer {
  text-align: center;
  color: #52677f;
  font-size: 11px;
  margin-top: 25px;
}
</style>
</head>

<body>

<div class="app">

  <div class="header">
    <div>
      <div class="title">Solar Weather</div>
      <div class="subtitle">Earth & Space Conditions</div>
    </div>

    <button class="refresh" onclick="refreshApp()">↻</button>
  </div>

  <div class="location">
    📍 <span id="location">Your Location</span>
  </div>

  <section class="hero">

    <div class="sun"></div>

    <div class="hero-label">Current Weather</div>

    <div class="temperature" id="temperature">72°</div>

    <div class="condition" id="condition">
      Partly Cloudy
    </div>

    <div class="highlow">
      H 78° &nbsp; • &nbsp; L 61°
    </div>

  </section>

  <div class="section-title">
    Solar Conditions
  </div>

  <div class="cards">

    <div class="card">
      <div class="card-icon">☀️</div>
      <div class="card-name">Solar Flux</div>
      <div class="card-value">142</div>
      <div class="card-status">Elevated</div>
    </div>

    <div class="card">
      <div class="card-icon">🧲</div>
      <div class="card-name">Geomagnetic</div>
      <div class="card-value">Kp 3</div>
      <div class="card-status">Quiet</div>
    </div>

    <div class="card">
      <div class="card-icon">⚡</div>
      <div class="card-name">Solar Flares</div>
      <div class="card-value">Low</div>
      <div class="card-status">Stable</div>
    </div>

    <div class="card">
      <div class="card-icon">🌌</div>
      <div class="card-name">Aurora Chance</div>
      <div class="card-value">32%</div>
      <div class="card-status">Possible</div>
    </div>

  </div>

  <div class="section-title">
    Solar Activity
  </div>

  <div class="activity">

    <div class="activity-top">
      <div class="activity-name">Geomagnetic Activity</div>
      <div class="badge">LOW</div>
    </div>

    <div class="bar">
      <div class="bar-fill"></div>
    </div>

    <div class="scale">
      <span>Quiet</span>
      <span>Active</span>
      <span>Storm</span>
    </div>

  </div>

  <div class="section-title">
    5-Day Forecast
  </div>

  <div class="forecast">

    <div class="day">
      <div class="day-name">Today</div>
      <div class="day-icon">☀️</div>
      <div class="day-temp">72°</div>
    </div>

    <div class="day">
      <div class="day-name">Tue</div>
      <div class="day-icon">🌤️</div>
      <div class="day-temp">75°</div>
    </div>

    <div class="day">
      <div class="day-name">Wed</div>
      <div class="day-icon">☀️</div>
      <div class="day-temp">79°</div>
    </div>

    <div class="day">
      <div class="day-name">Thu</div>
      <div class="day-icon">⛅</div>
      <div class="day-temp">77°</div>
    </div>

    <div class="day">
      <div class="day-name">Fri</div>
      <div class="day-icon">🌧️</div>
      <div class="day-temp">69°</div>
    </div>

  </div>

  <div class="info">
    🌎 <strong>Space Weather Tip</strong><br><br>
    Solar activity can affect satellites, radio communications,
    GPS signals, and create auroras at higher latitudes.
  </div>

  <div class="footer">
    Solar Weather • Space & Earth Conditions
  </div>

</div>

<script>

function refreshApp() {

  const button = document.querySelector(".refresh");

  button.style.transform = "rotate(360deg)";

  setTimeout(() => {
    button.style.transform = "";
  }, 500);

  const temperatures = [68, 70, 72, 74, 76, 78];
  const conditions = [
    "Sunny",
    "Partly Cloudy",
    "Clear Skies",
    "Mostly Sunny"
  ];

  const temp =
    temperatures[Math.floor(Math.random() * temperatures.length)];

  const condition =
    conditions[Math.floor(Math.random() * conditions.length)];

  document.getElementById("temperature").textContent = temp + "°";
  document.getElementById("condition").textContent = condition;
}


if ("geolocation" in navigator) {

  navigator.geolocation.getCurrentPosition(
    function(position) {

      document.getElementById("location").textContent =
        "Current Location";

    },
    function() {

      document.getElementById("location").textContent =
        "Location unavailable";

    }
  );

}

</script>

</body>
</html>
