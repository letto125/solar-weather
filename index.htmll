<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Solar Weather">

<title>Solar Weather</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", Arial, sans-serif;
    background: linear-gradient(180deg, #07152f, #102d57 55%, #07152f);
    color: white;
    min-height: 100vh;
}

.app {
    max-width: 500px;
    margin: auto;
    padding: 55px 20px 35px;
}

.header {
    text-align: center;
    margin-bottom: 25px;
}

.sun {
    font-size: 58px;
    margin-bottom: 5px;
}

h1 {
    font-size: 34px;
    margin: 0;
}

.subtitle {
    color: #b9c8df;
    margin-top: 7px;
}

.card {
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 25px;
    padding: 22px;
    margin-bottom: 16px;
    backdrop-filter: blur(15px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
}

.location {
    text-align: center;
}

.location button {
    margin-top: 12px;
}

.temp {
    text-align: center;
    font-size: 65px;
    font-weight: 700;
}

.condition {
    text-align: center;
    font-size: 20px;
    color: #d9e5f7;
}

.grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

.stat {
    background: rgba(0,0,0,0.18);
    border-radius: 18px;
    padding: 16px;
}

.stat-title {
    color: #aebed6;
    font-size: 13px;
}

.stat-value {
    font-size: 22px;
    font-weight: 600;
    margin-top: 6px;
}

button {
    width: 100%;
    border: none;
    border-radius: 16px;
    padding: 15px;
    font-size: 17px;
    font-weight: 600;
    background: #ffffff;
    color: #102d57;
    cursor: pointer;
}

button:active {
    transform: scale(0.97);
}

.refresh {
    background: rgba(255,255,255,0.16);
    color: white;
    border: 1px solid rgba(255,255,255,0.2);
}

.status {
    text-align: center;
    color: #aebed6;
    font-size: 13px;
    margin-top: 12px;
}

.alert {
    border-left: 4px solid #ffd166;
}

.alert-title {
    font-weight: 700;
    font-size: 18px;
    margin-bottom: 6px;
}

.forecast-title {
    font-size: 19px;
    font-weight: 700;
    margin-bottom: 15px;
}

.day {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 13px 0;
    border-bottom: 1px solid rgba(255,255,255,0.1);
}

.day:last-child {
    border-bottom: none;
}

.day-name {
    width: 70px;
}

.icon {
    font-size: 25px;
}

.aurora {
    text-align: center;
    font-size: 20px;
    padding: 12px;
}

.footer {
    text-align: center;
    color: #8195b4;
    font-size: 12px;
    margin-top: 25px;
}
</style>
</head>

<body>

<div class="app">

    <div class="header">
        <div class="sun">☀️</div>
        <h1>Solar Weather</h1>
        <div class="subtitle">Space weather at a glance</div>
    </div>

    <div class="card location">
        <strong>📍 Your Location</strong>
        <br>
        <button onclick="getLocation()">Use My Location</button>
        <div id="locationText" class="status">Location not selected</div>
    </div>

    <div class="card">
        <div class="temp" id="solarIndex">4</div>
        <div class="condition">Current Solar Activity</div>
    </div>

    <div class="card">
        <div class="grid">

            <div class="stat">
                <div class="stat-title">☀️ Solar Activity</div>
                <div class="stat-value" id="activity">Moderate</div>
            </div>

            <div class="stat">
                <div class="stat-title">🌌 Aurora Chance</div>
                <div class="stat-value" id="auroraChance">35%</div>
            </div>

            <div class="stat">
                <div class="stat-title">⚡ Solar Wind</div>
                <div class="stat-value" id="solarWind">420 km/s</div>
            </div>

            <div class="stat">
                <div class="stat-title">🧲 Kp Index</div>
                <div class="stat-value" id="kp">4.2</div>
            </div>

        </div>
    </div>

    <div class="card alert">
        <div class="alert-title">🌎 Space Weather Alert</div>
        <div id="alertText">
            Solar activity is currently moderate. Conditions are being monitored.
        </div>
    </div>

    <div class="card">
        <div class="forecast-title">🌌 Aurora Forecast</div>

        <div class="day">
            <div class="day-name">Tonight</div>
            <div class="icon">🌌</div>
            <strong id="tonight">35%</strong>
        </div>

        <div class="day">
            <div class="day-name">Tomorrow</div>
            <div class="icon">✨</div>
            <strong id="tomorrow">28%</strong>
        </div>

        <div class="day">
            <div class="day-name">Next Day</div>
            <div class="icon">🌙</div>
            <strong id="nextday">42%</strong>
        </div>
    </div>

    <div class="card">
        <div class="aurora">
            🟢 Aurora conditions are currently being monitored.
        </div>
        <button class="refresh" onclick="refreshData()">
            🔄 Refresh Solar Data
        </button>
        <div id="updated" class="status">
            Updated just now
        </div>
    </div>

    <div class="footer">
        Solar Weather • Space weather information
    </div>

</div>

<script>

function randomNumber(min, max) {
    return Math.floor(Math.random() * (max - min + 1)) + min;
}

function refreshData() {

    let index = randomNumber(1, 9);
    let kp = (Math.random() * 6 + 1).toFixed(1);
    let wind = randomNumber(350, 650);
    let aurora = randomNumber(10, 85);

    let activity;

    if (index <= 3) {
        activity = "Low";
    } else if (index <= 6) {
        activity = "Moderate";
    } else if (index <= 8) {
        activity = "High";
    } else {
        activity = "Severe";
    }

    document.getElementById("solarIndex").textContent = index;
    document.getElementById("activity").textContent = activity;
    document.getElementById("kp").textContent = kp;
    document.getElementById("solarWind").textContent = wind + " km/s";

    document.getElementById("auroraChance").textContent = aurora + "%";
    document.getElementById("tonight").textContent = aurora + "%";
    document.getElementById("tomorrow").textContent = randomNumber(10, 80) + "%";
    document.getElementById("nextday").textContent = randomNumber(10, 90) + "%";

    let message;

    if (index >= 8) {
        message = "High solar activity detected. Space weather conditions may be elevated.";
    } else if (index >= 5) {
        message = "Moderate solar activity detected. Conditions are being monitored.";
    } else {
        message = "Solar activity is currently low. Conditions are calm.";
    }

    document.getElementById("alertText").textContent = message;

    document.getElementById("updated").textContent =
        "Updated just now • " + new Date().toLocaleTimeString([], {
            hour: "numeric",
            minute: "2-digit"
        });
}

function getLocation() {

    if (!navigator.geolocation) {
        document.getElementById("locationText").textContent =
            "Location is not supported on this device.";
        return;
    }

    document.getElementById("locationText").textContent =
        "Finding your location...";

    navigator.geolocation.getCurrentPosition(

        function(position) {

            let lat = position.coords.latitude.toFixed(2);
            let lon = position.coords.longitude.toFixed(2);

            document.getElementById("locationText").textContent =
                "Location found • " + lat + ", " + lon;
        },

        function() {

            document.getElementById("locationText").textContent =
                "Location permission was not granted.";
        }
    );
}

refreshData();

</script>

</body>
</html>
